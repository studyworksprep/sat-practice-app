        "answer": "-2",
        "allow_retry": false,
        "explanation": "Graph \\(\\lvert 2x-1\\rvert-5\\). The smaller intercept gives \\(r=-2\\)."
      },
      "calculator": {
        "display": "open",
        "mode": "scratch",
        "title": "Independent practice 2"
      }
    },
    {
      "kind": "raw_block",
      "id": "practice_solution_count",
      "block_type": "check",
      "content": {
        "prompt": "How many distinct real solutions does \\(x^4+20=8x^2\\) have?",
        "input": "numeric",
        "answer": "0",
        "allow_retry": false,
        "explanation": "Graph \\(x^4-8x^2+20\\). It stays above the x-axis, so there are no real solutions."
      },
      "calculator": {
        "display": "open",
        "mode": "scratch",
        "title": "Independent practice 3"
      }
    },
    {
      "kind": "raw_block",
      "id": "practice_exact_answer",
      "block_type": "check",
